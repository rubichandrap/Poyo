<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The C# server core ships as source inside @rubichandrap/poyo (ADR 0008)
       and compiles in place through the pnpm workspace link. The defensive
       remove stops the SDK's default glob from double-compiling the files
       under node_modules. -->
  <ItemGroup>
    <Compile Remove="node_modules/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../node_modules/@rubichandrap/poyo/server/**/*.cs" LinkBase="Framework" />
  </ItemGroup>

  <Target Name="PoyoServerCoreGuard" BeforeTargets="CoreCompile;FindRazorFiles">
    <Error Condition="!Exists('../node_modules/@rubichandrap/poyo/server/RoutePolicy.cs')"
           Text="Poyo server core not found at ../node_modules/@rubichandrap/poyo/server. Run 'pnpm install' in the repository root, then build again." />
  </Target>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <!-- Pin above the transitive 2.0.0 from Microsoft.AspNetCore.OpenApi:
         GHSA-v5pm-xwqc-g5wc (circular schema references crash the OpenAPI parser). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="Vite.AspNetCore" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
