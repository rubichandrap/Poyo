	"components": {
		"schemas": {
			"JSendResponseOfLoginResponse": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string"
					},
					"data": {
						"type": "object",
						"oneOf": [
							{
								"$ref": "#/components/schemas/LoginResponse"
							}
						],
						"nullable": true
					},
					"message": {
						"type": "string",
						"nullable": true
					}
				}
			},
			"JSendResponseOfLogoutResponse": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string"
					},
					"data": {
						"type": "object",
						"oneOf": [
							{
								"$ref": "#/components/schemas/LogoutResponse"
							}
						],
						"nullable": true
					},
					"message": {
						"type": "string",
						"nullable": true
					}
				}
			},
			"JSendResponseOfObject": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string"
					},
					"data": {},
					"message": {
						"type": "string",
						"nullable": true
					}
				}
			},
			"LoginRequest": {
				"required": ["username", "password"],
				"type": "object",
				"properties": {
					"username": {
						"maxLength": 150,
						"minLength": 0,
						"type": "string"
					},
					"password": {
						"maxLength": 100,
						"minLength": 2,
						"type": "string"
					},
					"rememberMe": {
						"type": "boolean"
					},
					"appType": {
						"type": "string"
					}
				}
			},
			"LoginResponse": {
				"type": "object",
				"properties": {
					"token": {
						"type": "string"
					},
					"refreshToken": {
						"type": "string"
					},
					"expiration": {
						"type": "string",
						"format": "date-time"
					},
					"username": {
						"type": "string"
					}
				}
			},
			"LogoutResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					},
					"success": {
						"type": "boolean"
					}
				}
			},
			"RefreshRequest": {
				"type": "object",
				"properties": {
					"token": {
						"type": "string"
					},
					"refreshToken": {
						"type": "string"
					}
				}
			}
		}
