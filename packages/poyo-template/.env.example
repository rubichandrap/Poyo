# =====================
# Global Environment
# =====================
# NOTE: ASPNETCORE_ENVIRONMENT is deliberately absent. The process owns the
# hosting environment, and `dotnet run` sets it to Development from
# Poyo.Server/Properties/launchSettings.json. A value here is ignored: the
# server reads the environment from the process before it reads this file, so
# this file can never decide the environment it is conditional on. Set the
# hosting environment on the host (service manager, container, IIS) instead.
NODE_ENV=development

# =====================
# Client (Vite)
# =====================
VITE_APP_NAME=Poyo
VITE_SERVER_URL=http://localhost:5104
VITE_OPENAPI_URL=http://localhost:5104/openapi/v1.json

# =====================
# Server (.NET)
# =====================
AllowedHosts=*

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Connection Strings (Optional - for your own database)
# ConnectionStrings__DB=Server=localhost;Database=YourDB;User Id=user;Password=pass;
# ConnectionStrings__CommandTimeout=60

# Vite Service
Vite__Server__AutoRun=true
Vite__Server__Port=5173
Vite__Server__Https=false
Vite__Server__PackageDirectory=../
Vite__Server__DevServerUrl=http://localhost:5173

# =====================
# NOTES
# =====================
# - This file is a development convenience and never travels with a published
#   application. The server reads it only when the process says development or
#   says nothing, and it fills gaps without ever overriding a value the process
#   has already set.
# - Auth is now demo-only (hardcoded credentials: demo/password)
# - Add your own database connection string if needed
# - Customize as needed for your application