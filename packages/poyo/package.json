{
	"name": "@rubichandrap/poyo",
	"version": "0.5.0-beta.0",
	"description": "The Poyo project CLI, client runtime, and C# server core: route management, build glue, OpenAPI-to-TypeScript codegen, the usePage server-data accessor, and the registry-backed server framework.",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/rubichandrap/Poyo.git"
	},
	"type": "module",
	"bin": {
		"poyo": "./dist/index.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./runtime": "./dist/runtime/index.js",
		"./runtime/link": "./dist/runtime/link.js",
		"./runtime/router": "./dist/runtime/router.js"
	},
	"files": [
		"dist",
		"server"
	],
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx src/index.ts",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm run build && vitest run",
		"test:watch": "vitest",
		"lint": "biome lint src test",
		"lint:fix": "biome lint src test --write",
		"format": "biome format src test",
		"format:fix": "biome format src test --write"
	},
	"dependencies": {
		"@inquirer/prompts": "8.2.0",
		"commander": "14.0.2",
		"openapi-typescript": "7.13.0",
		"openapi-zod-client": "1.18.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/node": "24.6.0",
		"@types/react": "19.1.16",
		"react": "19.1.1",
		"tsx": "4.20.3",
		"typescript": "6.0.3",
		"vitest": "3.2.4"
	},
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20.19.0",
		"pnpm": ">=9"
	}
}
